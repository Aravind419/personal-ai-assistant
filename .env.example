# ==============================================================================
# Phase 0: Personal AI Agent - Environment Configuration Template
# Copy this file to .env and customize values for local development.
# ==============================================================================

# --- Application Core ---
APP_ENV=development
APP_NAME="Personal AI Assistant"
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-insecure-key-for-local-development-only-min-32-chars

# --- Server Binding ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL (SQLAlchemy asyncpg format)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_ai_db

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Personal AI Assistant"
VITE_APP_ENV=development

# --- Future Phase Placeholders (Not used in Phase 0) ---
# OPENAI_API_KEY=your_openai_api_key_here
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
